rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }

    function isMember(teamId) {
      return signedIn() && (
        exists(/databases/$(database)/documents/teams/$(teamId)/members/$(uid())) ||
        get(/databases/$(database)/documents/users/$(uid())).data.activeTeamId == teamId
      );
    }

    function getRole(teamId) {
      return get(/databases/$(database)/documents/teams/$(teamId)/members/$(uid())).data.role;
    }

    function isManager(teamId) {
      return isMember(teamId) && getRole(teamId) in ['owner', 'admin', 'staff'];
    }

    function noteReader(teamId) {
      return signedIn() && exists(/databases/$(database)/documents/teams/$(teamId)/members/$(uid()))
        && getRole(teamId) in ['owner', 'admin', 'staff', 'captain', 'member'];
    }

    function notePoster(teamId) {
      return noteReader(teamId) && (getRole(teamId) in ['owner', 'admin', 'staff', 'captain']
        || get(/databases/$(database)/documents/teams/$(teamId)/members/$(uid())).data.get('canPostTacticalNotes', false) == true);
    }

    function noteEditor(teamId) {
      return noteReader(teamId) && (resource.data.authorUid == uid() || getRole(teamId) in ['owner', 'admin']);
    }

    function validNote() {
      let data = request.resource.data;
      return data.keys().hasOnly(['title', 'description', 'assigneeUids', 'clips', 'sourceProjectId', 'authorUid', 'authorName', 'createdAt', 'updatedAt', 'images', 'tasks', 'contentVersion', 'draft'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 120
        && data.description is string && data.description.size() <= 5000
        && data.assigneeUids is list && data.assigneeUids.size() <= 500
        && data.clips is list && data.clips.size() <= 100
        && data.get('images', []) is list && data.get('images', []).size() <= 6
        && (data.clips.size() > 0 || data.get('images', []).size() > 0 || data.get('draft', false) == true)
        && data.get('tasks', {}) is map && data.get('tasks', {}).size() <= 30
        && data.get('contentVersion', 1) is int && data.get('contentVersion', 1) > 0
        && data.get('draft', false) is bool
        && data.sourceProjectId is string && data.authorName is string
        && data.authorUid is string && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function inviteOk(code, teamId) {
      return code is string
        && exists(/databases/$(database)/documents/invites/$(code))
        && get(/databases/$(database)/documents/invites/$(code)).data.teamId == teamId
        && get(/databases/$(database)/documents/invites/$(code)).data.active == true;
    }

    match /appConfig/{documentId} {
      allow get: if documentId == 'versionPolicy';
      allow list, create, update, delete: if false;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && userId == uid();
      allow delete: if false;

      match /personalEvents/{eventId} {
        allow read, write: if signedIn() && userId == uid();
      }

      match /notifications/{notificationId} {
        allow read: if signedIn() && userId == uid();
        allow write: if false;
      }

      match /notificationState/{stateId} {
        allow read: if signedIn() && userId == uid();
        allow write: if false;
      }

      match /notificationPreferences/{preferenceId} {
        allow read: if signedIn() && userId == uid();
        allow write: if false;
      }

      match /pushTokens/{tokenId} {
        allow read, write: if false;
      }
      match /loadingReadTeams/{teamId} {
        allow read, write: if false;
      }
      match /workspaceReactionReceipts/{receiptId} {
        allow get: if signedIn() && userId == uid();
        allow list, write: if false;
      }
      match /workspaceReactionTeams/{teamId} {
        allow read, write: if false;
      }
    }

    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.createdBy == uid();
      allow update, delete: if signedIn() && isManager(resource.data.teamId);
    }

    match /notificationPushTokens/{tokenHash} {
      allow read, write: if false;
    }

    match /teams/{teamId} {
      allow get: if isMember(teamId);
      allow list: if false;

      allow create: if signedIn() && request.resource.data.createdBy == uid()
        && request.resource.data.get('dailyReportCommentsEnabled', false) is bool
        && (request.resource.data.get('dailyReportCommentsEnabled', false) == false
          || request.resource.data.get('dailyReportCommentsUpdatedAt', null) == request.time);
      allow update: if isManager(teamId)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['dailyReportCommentsEnabled', 'dailyReportCommentsUpdatedAt'])
          || (getRole(teamId) in ['owner', 'admin']
            && request.resource.data.get('dailyReportCommentsEnabled', false) is bool
            && request.resource.data.get('dailyReportCommentsUpdatedAt', null) == request.time));
      allow delete: if isManager(teamId);

      match /members/{memberId} {
        allow get, list: if isMember(teamId);

        allow create: if signedIn() && memberId == uid() && (
          (get(/databases/$(database)/documents/teams/$(teamId)).data.createdBy == uid()
            && request.resource.data.role == 'admin')
          ||
          (inviteOk(request.resource.data.inviteCode, teamId)
            && request.resource.data.role == 'member'
            && request.resource.data.get('canPostTacticalNotes', false) == false)
        );

        allow update: if isMember(teamId) && (isManager(teamId) || (memberId == uid()
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'canPostTacticalNotes'])
            || (get(/databases/$(database)/documents/teams/$(teamId)).data.createdBy == uid()
              && request.resource.data.role == 'admin'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])))));
        allow delete: if isMember(teamId) && (memberId == uid() || isManager(teamId));
      }

      match /clubEvents/{eventId} {
        allow read, write: if isMember(teamId);
      }

      match /notices/{noticeId} {
        allow read, write: if isMember(teamId);
      }

      match /workspacePosts/{postId} {
        allow read: if isMember(teamId);
        allow create: if isMember(teamId)
          && request.resource.data.get('authorUid', '') == uid()
          && !request.resource.data.keys().hasAny(['reactionUserUids', 'reactionMigrationPending'])
          && request.resource.data.get('reactions', {}) == {}
          && request.resource.data.get('reactionPrivacyVersion', 1) == 1
          && !exists(/databases/$(database)/documents/teams/$(teamId)/workspacePostReactionDetails/$(postId));
        allow update: if isMember(teamId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'authorUid', 'reactions', 'reactionUserUids', 'reactionPrivacyVersion', 'reactionMigrationPending'
          ]);
        allow delete: if isMember(teamId) && (isManager(teamId) || resource.data.get('authorUid', '') == uid());
      }
      match /workspacePostReactionDetails/{postId} {
        function visibleParent() {
          let parent = get(/databases/$(database)/documents/teams/$(teamId)/workspacePosts/$(postId)).data;
          return parent.get('status', '') != 'deleted' && parent.get('moderationStatus', '') != 'hidden'
            && (!parent.keys().hasAny(['visibleToUids']) || uid() in parent.visibleToUids);
        }
        allow get: if signedIn()
          && exists(/databases/$(database)/documents/teams/$(teamId)/members/$(uid()))
          && (getRole(teamId) in ['owner', 'admin', 'staff'] || resource.data.get('authorUid', '') == uid())
          && visibleParent();
        allow list, write: if false;
      }

      match /loadingOptimization/{stateId} {
        allow read: if isMember(teamId);
        allow write: if false;
      }
      match /loadingSummaries/{memberId} {
        allow read: if isMember(teamId) && memberId == uid();
        allow write: if false;
      }
      match /latestDailyReports/{memberId} {
        allow read: if isMember(teamId);
        allow write: if false;
      }
      match /loadingEntries/{entryId} {
        allow read, write: if false;
      }
      match /workspacePostReadStates/{postId} {
        function ownMap(field) {
          let before = resource == null ? {} : resource.data.get(field, {});
          let after = request.resource.data.get(field, {});
          return after is map && after.diff(before).affectedKeys().hasOnly([uid()]);
        }
        function validReadState() {
          let data = request.resource.data;
          let parent = get(/databases/$(database)/documents/teams/$(teamId)/workspacePosts/$(postId)).data;
          let readers = data.get('readers', {});
          let oldReaders = resource == null ? {} : resource.data.get('readers', {});
          return data.keys().hasOnly(['readers', 'notificationReads', 'notificationDismissals', 'updatedAt'])
            && data.updatedAt == request.time
            && parent.get('status', '') != 'deleted'
            && uid() in parent.get('visibleToUids', [])
            && ownMap('readers') && ownMap('notificationReads') && ownMap('notificationDismissals')
            && (readers.diff(oldReaders).affectedKeys().size() == 0
              || (getRole(teamId) != 'guardian' && uid() in parent.get('readTargetUids', []) && readers[uid()] == true))
            && data.get('notificationReads', {}).get(uid(), []) is list
            && data.get('notificationDismissals', {}).get(uid(), []) is list;
        }
        allow read: if isMember(teamId);
        allow create, update: if isMember(teamId) && validReadState();
        allow delete: if false;
      }

      match /dailyReports/{reportId} {
        function commentsEnabled() {
          return getAfter(/databases/$(database)/documents/teams/$(teamId)).data.get('dailyReportCommentsEnabled', false) == true;
        }
        allow read, delete: if isMember(teamId);
        allow create: if isMember(teamId)
          && (request.resource.data.get('comments', []) == [] || commentsEnabled());
        allow update: if isMember(teamId)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['comments'])
            || commentsEnabled());
      }

      match /projects/{projectId} {
        allow read, write: if isMember(teamId);

        match /videos/{videoId} {
          allow read, write: if isMember(teamId);

          match /events/{videoEventId} {
            allow read, write: if isMember(teamId);
          }
        }
      }

      match /highlightProjects/{highlightProjectId} {
        allow read, write: if isMember(teamId);
      }

      match /tacticalNoteSummaries/{noteId} {
        allow read: if noteReader(teamId);
        allow write: if false;
      }
      match /system/{documentId} {
        allow read, write: if false;
      }
      match /tacticalNotes/{noteId} {
        function parentNote() { return get(/databases/$(database)/documents/teams/$(teamId)/tacticalNotes/$(noteId)).data; }
        function parentEditor() { return noteReader(teamId) && (parentNote().authorUid == uid() || getRole(teamId) in ['owner', 'admin']); }
        function summaryCurrent() {
          let index = get(/databases/$(database)/documents/teams/$(teamId)/tacticalNoteSummaries/$(noteId)).data;
          return index.noteUpdatedAt == parentNote().updatedAt
            && index.contentVersion == parentNote().get('contentVersion', 1);
        }
        function validProgress(history) {
          let data = request.resource.data;
          let task = parentNote().get('tasks', {})[data.taskId];
          return data.keys().hasOnly(['taskId', 'uid', 'taskRevision', 'status', 'comment', 'updatedBy', 'updatedAt', 'completedAt', 'taskText'])
            && (!data.keys().hasAny(['taskText']) || (history && data.taskText == task.text))
            && data.taskId is string && data.uid is string && data.uid in task.assigneeUids
            && data.taskRevision == task.revision
            && data.comment is string && data.comment.size() <= 2000
            && data.updatedBy == uid() && data.updatedAt == request.time
            && ((data.status == 'done' && data.completedAt == request.time)
              || (data.status in ['pending', 'returned'] && data.completedAt == null))
            && ((data.uid == uid() && data.status in ['done', 'pending'])
              || (parentEditor() && data.status == 'returned' && data.comment.size() > 0));
        }
        allow read: if noteReader(teamId);
        allow create: if notePoster(teamId) && validNote()
          && request.resource.data.get('contentVersion', 1) == 1
          && request.resource.data.authorUid == uid() && request.resource.data.createdAt == request.time;
        allow update: if noteEditor(teamId) && validNote()
          && (request.resource.data.get('contentVersion', 1) == resource.data.get('contentVersion', 1)
            || (request.resource.data.get('contentVersion', 1) == resource.data.get('contentVersion', 1) + 1
              && request.resource.data.diff(resource.data).affectedKeys().hasAny(['title', 'description', 'assigneeUids', 'clips', 'images'])))
          && request.resource.data.authorUid == resource.data.authorUid
          && request.resource.data.authorName == resource.data.authorName
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if noteEditor(teamId);
        match /responses/{responseId} {
          allow read: if noteReader(teamId);
          allow create: if noteReader(teamId) && uid() in parentNote().assigneeUids && summaryCurrent()
            && request.resource.data.keys().hasOnly(['uid', 'version', 'status', 'text', 'createdAt', 'resolved', 'resolvedAt', 'resolvedBy'])
            && request.resource.data.uid == uid() && request.resource.data.version == parentNote().get('contentVersion', 1)
            && request.resource.data.status in ['read', 'understood', 'question']
            && request.resource.data.text is string && request.resource.data.text.size() <= 2000
            && (request.resource.data.status != 'question' || request.resource.data.text.size() > 0)
            && request.resource.data.get('resolved', false) == false
            && request.resource.data.get('resolvedAt', null) == null && request.resource.data.get('resolvedBy', null) == null
            && request.resource.data.createdAt == request.time;
          allow update: if noteReader(teamId) && resource.data.status == 'question' && resource.data.uid == uid()
            && resource.data.get('resolved', false) == false
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolved', 'resolvedAt', 'resolvedBy'])
            && request.resource.data.resolved == true && request.resource.data.resolvedAt == request.time
            && request.resource.data.resolvedBy == uid();
          allow delete: if parentEditor();
        }
        match /attachmentUploads/{uploadId} {
          allow read: if parentEditor();
          allow create: if parentEditor() && uploadId.matches('^[a-zA-Z0-9_-]+$')
            && request.resource.data.keys().hasOnly(['uploaderUid', 'storagePath', 'size', 'createdAt'])
            && request.resource.data.uploaderUid == uid() && request.resource.data.createdAt == request.time
            && request.resource.data.size is int && request.resource.data.size > 0 && request.resource.data.size <= 10 * 1024 * 1024
            && request.resource.data.storagePath == 'tacticalNoteAttachments/' + teamId + '/' + noteId + '/' + uploadId + '.jpg';
          allow update, delete: if false;
        }
        match /replies/{replyId} {
          allow read: if noteReader(teamId);
          allow create: if parentEditor()
            && request.resource.data.keys().hasOnly(['responseId', 'uid', 'text', 'createdAt'])
            && request.resource.data.uid == uid() && request.resource.data.text is string
            && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
            && get(/databases/$(database)/documents/teams/$(teamId)/tacticalNotes/$(noteId)/responses/$(request.resource.data.responseId)).data.status == 'question'
            && request.resource.data.createdAt == request.time;
          allow update: if false;
          allow delete: if parentEditor();
        }
        match /progress/{progressId} {
          allow read: if noteReader(teamId);
          allow create, update: if noteReader(teamId) && validProgress(false)
            && progressId == request.resource.data.taskId + '_' + request.resource.data.uid;
          allow delete: if parentEditor();
        }
        match /progressHistory/{historyId} {
          allow read: if noteReader(teamId);
          allow create: if noteReader(teamId) && validProgress(true)
            && request.resource.data.diff(getAfter(/databases/$(database)/documents/teams/$(teamId)/tacticalNotes/$(noteId)/progress/$(request.resource.data.taskId + '_' + request.resource.data.uid)).data).affectedKeys().hasOnly(['taskText']);
          allow update: if false;
          allow delete: if parentEditor();
        }
      }

      match /tagGroups/{tagGroupId} {
        allow read, write: if isMember(teamId);
      }

      match /tags/{tagId} {
        allow read, write: if isMember(teamId);
      }
    }
  }
}
